{
  "name": "@bearmaxdd/omp-compliance",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./extension": "./dist/extension.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "omp": {
    "extensions": ["./dist/extension.js"]
  },
  "scripts": {
    "build": "rm -rf dist && tsgo -p tsconfig.json",
    "bundle:omp": "bun build src/extension.ts --target=bun --format=esm --banner='// @ts-nocheck' --outfile=dist/extension.bundle.js",
    "check": "cd ../.. && biome check packages/omp-compliance/src packages/omp-compliance/test",
    "test": "bun test --preload ./test/setup.ts"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=17.0.1 <18"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "file:/Users/mima1234/Code/super/.worktrees/oh-my-pi-v17-advisor-protocol/packages/coding-agent",
    "@oh-my-pi/pi-agent-core": "17.0.1",
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "^5.7.0"
  }
}
